diff --git a/src/styles/tahoe-glass.css b/src/styles/tahoe-glass.css
new file mode 100644
index 0000000..09c213d
--- /dev/null
+++ b/src/styles/tahoe-glass.css
@@ -0,0 +1,49 @@
+/* tahoe glass (cachyos-tahoe-theme): brighter glass edges on blurred menus and on
+   each quick settings piece, which is blurred on its own with no card behind it. */
+.bms-popup-background-transparent .popup-menu-content,
+.bms-popup-background-transparent .notification-banner,
+.bms-popup-background-transparent .quick-toggle-menu,
+.bms-popup-background-transparent .modal-dialog,
+.bms-popup-background-transparent .quick-toggle,
+.bms-popup-background-transparent .quick-toggle-has-menu,
+.bms-popup-background-transparent .quick-slider,
+.bms-popup-background-transparent .quick-settings-system-item .icon-button,
+.bms-popup-background-dark .popup-menu-content,
+.bms-popup-background-dark .notification-banner,
+.bms-popup-background-dark .quick-toggle-menu,
+.bms-popup-background-dark .modal-dialog,
+.bms-popup-background-dark .quick-toggle,
+.bms-popup-background-dark .quick-toggle-has-menu,
+.bms-popup-background-dark .quick-slider,
+.bms-popup-background-dark .quick-settings-system-item .icon-button,
+.bms-popup-background-light .popup-menu-content,
+.bms-popup-background-light .notification-banner,
+.bms-popup-background-light .quick-toggle-menu,
+.bms-popup-background-light .modal-dialog,
+.bms-popup-background-light .quick-toggle,
+.bms-popup-background-light .quick-toggle-has-menu,
+.bms-popup-background-light .quick-slider,
+.bms-popup-background-light .quick-settings-system-item .icon-button {
+  border: 1px solid rgba(255, 255, 255, 0.55) !important;
+  box-shadow: inset 0 0 6px rgba(255, 255, 255, 0.18) !important;
+}
+
+/* a split toggle draws one outline, not one per half */
+.bms-popup-background-transparent .quick-toggle-has-menu .quick-toggle,
+.bms-popup-background-transparent .quick-toggle-has-menu .quick-toggle-menu-button,
+.bms-popup-background-dark .quick-toggle-has-menu .quick-toggle,
+.bms-popup-background-dark .quick-toggle-has-menu .quick-toggle-menu-button,
+.bms-popup-background-light .quick-toggle-has-menu .quick-toggle,
+.bms-popup-background-light .quick-toggle-has-menu .quick-toggle-menu-button {
+  border-color: transparent !important;
+  box-shadow: none !important;
+}
+
+/* no card behind quick settings */
+.bms-popup-background-transparent .popup-menu-content.quick-settings,
+.bms-popup-background-dark .popup-menu-content.quick-settings,
+.bms-popup-background-light .popup-menu-content.quick-settings {
+  background-color: transparent !important;
+  border: none !important;
+  box-shadow: none !important;
+}
