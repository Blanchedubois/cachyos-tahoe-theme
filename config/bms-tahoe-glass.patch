+    /// The outermost pieces only: a split toggle is blurred once, not per half.
+    find_quick_settings_pieces(quick_settings, targets) {
+        const stack = [...quick_settings.get_children()];
+        while (stack.length > 0) {
+            const child = stack.pop();
+            if (is_internal_actor(child))
+                continue;
+            // a split toggle (Wi-Fi, Bluetooth, power mode) is one piece: GNOME adds its
+            // 'quick-toggle-has-menu' class only once the menu is ready, so it is also known
+            // by its widget type, or its toggle and arrow would be blurred apart
+            if (this.has_any_style_class(child, QUICK_SETTINGS_PIECE_STYLE_CLASSES)
+                || child instanceof QuickMenuToggle) {
+                targets.add(child);
+                continue;
+            }
+            stack.push(...child.get_children());
+        }
+    }
