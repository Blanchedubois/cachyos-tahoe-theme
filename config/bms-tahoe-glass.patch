+    /// The outermost pieces only: a split toggle is blurred once, not per half.
+    find_quick_settings_pieces(quick_settings, targets) {
+        const stack = [...quick_settings.get_children()];
+        while (stack.length > 0) {
+            const child = stack.pop();
+            if (is_internal_actor(child))
