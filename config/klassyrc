[ButtonBehaviour]
LockButtonBehaviourActiveInactive=true
LockCloseButtonBehaviourActive=true
ShowBackgroundNormallyActive=false
ShowBackgroundOnHoverActive=false
ShowBackgroundOnPressActive=false
ShowCloseBackgroundNormallyActive=false
ShowCloseBackgroundOnHoverActive=false
ShowCloseBackgroundOnPressActive=false
ShowCloseIconNormallyActive=true
ShowCloseIconOnHoverActive=true
ShowCloseIconOnPressActive=true
ShowCloseOutlineNormallyActive=false
ShowCloseOutlineOnHoverActive=false
ShowCloseOutlineOnPressActive=false
ShowIconNormallyActive=true
ShowIconOnHoverActive=true
ShowIconOnPressActive=true
ShowOutlineNormallyActive=false
ShowOutlineOnHoverActive=false
ShowOutlineOnPressActive=false
VaryColorCloseIconActive=LeastTitleBarHover
VaryColorIconActive=LeastTitleBarHover

[ButtonColors]
ButtonIconColorsActive=AccentTrafficLights
CloseButtonIconColorActive=AsSelected

[Global]
LookAndFeelSet=com.github.vinceliuice.MacTahoe-Dark

[ShadowStyle]
LockShadowStyleActiveInactive=true
ShadowColorActive=0,0,0
ShadowColorInactive=0,0,0
ShadowSizeActive=Large
ShadowSizeInactive=Large
ShadowStrengthActive=255
ShadowStrengthInactive=255

[TitleBarSpacing]
TitleAlignment=AlignCenter
TitleBarBottomMargin=4
TitleBarTopMargin=4

[Windeco]
BoldButtonIcons=Bold
ButtonIconStyle=Material
ButtonShape=IntegratedRoundedRectangle
IconSize=LargeMedium
RoundAllCornersWhenNoBorders=true
WindowCornerRadius=0

[WindowOutlineStyle]
LockWindowOutlineStyleActiveInactive=true
WindowOutlineStyleActive=None
WindowOutlineStyleInactive=None
