[Desktop Entry]
Name=Tahoe-Material
Comment=MacTahoe-Dark with popup cards and tooltips on the same glass as the panel
X-KDE-PluginInfo-Author=CachyOS Tahoe theme
X-KDE-PluginInfo-Name=Tahoe-Material
X-KDE-PluginInfo-Version=1.1
X-KDE-PluginInfo-License=GPL-3.0
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=5.0

[Settings]
FallbackTheme=MacTahoe-Dark

[ContrastEffect]
enabled=false

[BlurBehindEffect]
enabled=true

[AdaptiveTransparency]
enabled=true

[Wallpaper]
defaultWallpaperTheme=MacTahoe-Dark
defaultFileSuffix=.jpeg
defaultWidth=3840
defaultHeight=2160
